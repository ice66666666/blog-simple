# Example environment variables for local development
# Copy this file to .env and fill the values before running docker-compose

# Postgres
POSTGRES_DB=blog_db
POSTGRES_USER=blog_user
POSTGRES_PASSWORD=blog_password

# Backend / Flask
FLASK_APP=app.py
FLASK_ENV=development
DATABASE_URL=postgresql://blog_user:blog_password@db:5432/blog_db
JWT_SECRET_KEY=replace-with-a-secret

# Frontend
REACT_APP_API_URL=http://localhost:5000

# S3 / MinIO (bucket público)
S3_BUCKET=blog
S3_ENDPOINT=http://minio:9000
# Endpoint público accesible desde el navegador (host local)
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
